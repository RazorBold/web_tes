# ─── API ────────────────────────────────────────────────────────────
# Base URL REST backend (lihat docs/API.md). Kosongkan untuk pakai Route Handler
# lokal (src/app/api/v1) di app ini sendiri.
NEXT_PUBLIC_API_URL=

# ─── Database (MySQL) ───────────────────────────────────────────────
# Dipakai oleh src/lib/db.ts (server-side only, jangan pakai prefix NEXT_PUBLIC_)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=superweb_iot
DB_USER=dbadmin
DB_PASSWORD=

# ─── CCTV / NVR ─────────────────────────────────────────────────────
# Dipakai src/lib/cctv-nvr.ts (server-side saja — jangan pakai NEXT_PUBLIC_).
# Hanya login & get-stream yang lewat server; byte video + WebSocket AI diambil
# browser LANGSUNG dari NVR, jadi browser pemakai harus sejaringan dengan host ini.
NVR_HOST=
NVR_PORT=443
NVR_USERNAME=
NVR_PASSWORD=

# ─── LLM (DeepSeek) ─────────────────────────────────────────────────
# Dipakai src/lib/deepseek.ts (server-side saja — jangan pakai NEXT_PUBLIC_,
# kunci ini tidak boleh sampai ke browser).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ─── NVR History API (analitik AI) ──────────────────────────────────
# Layanan TERPISAH dari server streaming: HTTP biasa di port 8989, dan
# autentikasinya JWT HS256 buatan sendiri (payload kosong) — bukan token login.
NVR_HISTORY_URL=
# Tanda "$" pada secret WAJIB di-escape jadi \$ — dotenv memperluasnya sebagai
# nama variabel dan memotong nilainya tanpa peringatan.
NVR_HISTORY_JWT_SECRET=
# Broker MQTT over WebSocket untuk data realtime
NEXT_PUBLIC_MQTT_URL=ws://localhost:8083/mqtt
NEXT_PUBLIC_MQTT_USERNAME=frontend
NEXT_PUBLIC_MQTT_PASSWORD=

# ─── Auth ───────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# ─── Map ────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_DEFAULT_CENTER=[-6.2088,106.8456]
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# ─── Feature Flags ──────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATION=true
NEXT_PUBLIC_ENABLE_SOUND_ALERT=true
